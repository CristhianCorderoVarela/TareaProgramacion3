<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="cr.ac.una.tareaprogramacion3.controller.Ventana1Controller">

    <children>
        <BorderPane prefWidth="1100" prefHeight="700">

            <!-- Barra superior con acciones + búsqueda -->
            <top>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                    <Button text="+ Nuevo" onAction="#onNuevoProyecto"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button text="Editar" onAction="#onEditarSeleccion"
                            style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button text="Refrescar" onAction="#onRefrescar"
                            style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <!-- separador flexible -->
                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Búsqueda -->
                    <TextField fx:id="txtBuscar" promptText="Buscar en todos los campos..." prefWidth="320"/>
                    <Button fx:id="btnBuscar" text="Buscar"/>
                    <Button fx:id="btnLimpiar" text="Limpiar"/>
                </HBox>
            </top>

            <!-- 4 columnas de estado -->
            <center>
                <HBox spacing="20">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                    <!-- PLANIFICADO -->
                    <VBox spacing="10" prefWidth="250"
                          style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 1;">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="Planificados" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <ListView fx:id="listaPlanificados" prefHeight="580"/>
                    </VBox>

                    <!-- EN CURSO -->
                    <VBox spacing="10" prefWidth="250"
                          style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 1;">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="En Curso" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <ListView fx:id="listaEnProceso" prefHeight="580"/>
                    </VBox>

                    <!-- SUSPENDIDO -->
                    <VBox spacing="10" prefWidth="250"
                          style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 1;">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="Suspendidos" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <ListView fx:id="listaSuspendidos" prefHeight="580"/>
                    </VBox>

                    <!-- FINALIZADO -->
                    <VBox spacing="10" prefWidth="250"
                          style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 1;">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="Finalizados" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <ListView fx:id="listaFinalizados" prefHeight="580"/>
                    </VBox>

                </HBox>
            </center>

        </BorderPane>
    </children>
</StackPane>