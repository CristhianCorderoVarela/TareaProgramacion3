<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="cr.ac.una.tareaprogramacion3.controller.Ventana1Controller">

    <children>
        <BorderPane prefWidth="1000" prefHeight="650">

            <!-- Barra de acciones -->
            <top>
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                    <!-- (Opcional) campo de búsqueda: si luego quieres usarlo, agrega el handler en el controller -->
                    <!--
                    <TextField fx:id="txtFiltro" promptText="Buscar proyectos..."/>
                    <Button text="Buscar" onAction="#onBuscar"/>
                    <Separator orientation="VERTICAL"/>
                    -->

                    <Button text="+ Nuevo Proyecto"
                            onAction="#onNuevoProyecto"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button text="Editar"
                            onAction="#onEditarSeleccion"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button text="Refrescar"
                            onAction="#onRefrescar"
                            style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </top>

            <!-- Tres columnas con las listas -->
            <center>
                <HBox spacing="20">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                    <!-- Finalizados -->
                    <VBox spacing="10" prefWidth="300"
                          style="-fx-background-color: #ecf0f1; -fx-border-color: gray; -fx-border-width: 1;">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="Finalizados" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <ListView fx:id="listaFinalizados" prefHeight="500"/>
                    </VBox>

                    <!-- En Proceso -->
                    <VBox spacing="10" prefWidth="300"
                          style="-fx-background-color: #ecf0f1; -fx-border-color: gray; -fx-border-width: 1;">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="En Proceso" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <ListView fx:id="listaEnProceso" prefHeight="500"/>
                    </VBox>

                    <!-- En Pausa -->
                    <VBox spacing="10" prefWidth="300"
                          style="-fx-background-color: #ecf0f1; -fx-border-color: gray; -fx-border-width: 1;">
                        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                        <Label text="En Pausa" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <ListView fx:id="listaEnPausa" prefHeight="500"/>
                    </VBox>

                </HBox>
            </center>

        </BorderPane>
    </children>
</StackPane>
