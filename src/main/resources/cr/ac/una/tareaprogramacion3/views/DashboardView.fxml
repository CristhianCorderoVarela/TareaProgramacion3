<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.tareaprogramacion3.controller.DashboardController"
            prefWidth="1000" prefHeight="650">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Dashboard de Proyectos"
                   style="-fx-font-weight: bold; -fx-font-size: 20px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnActualizar" text="🔄 Actualizar" style="-fx-font-size: 12px;"/>
        </HBox>
    </top>

    <!-- CONTENIDO RESPONSIVE (sin scroll) -->
    <center>
        <AnchorPane>
            <children>
                <VBox spacing="16"
                      AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
                      AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>

                    <!-- FILA 1: Indicadores -->
                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <VBox alignment="CENTER" spacing="4" prefHeight="100"
                              style="-fx-background-color: #3498db; -fx-background-radius: 10; -fx-padding: 12;">
                            <Label fx:id="lblTotalProyectos" text="0"
                                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                            <Label text="Total Proyectos" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="4" prefHeight="100"
                              style="-fx-background-color: #27ae60; -fx-background-radius: 10; -fx-padding: 12;">
                            <Label fx:id="lblProyectosActivos" text="0"
                                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                            <Label text="Proyectos Activos" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="4" prefHeight="100"
                              style="-fx-background-color: #f39c12; -fx-background-radius: 10; -fx-padding: 12;">
                            <Label fx:id="lblProyectosFinalizados" text="0"
                                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                            <Label text="Proyectos Finalizados" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="4" prefHeight="100"
                              style="-fx-background-color: #e74c3c; -fx-background-radius: 10; -fx-padding: 12;">
                            <Label fx:id="lblAvancePromedio" text="0%"
                                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                            <Label text="Avance Promedio" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>

                    <!-- FILA 2: Gráfico + Tabla -->
                    <HBox spacing="16" VBox.vgrow="ALWAYS">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Estado de Proyectos"
                                   style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                            <PieChart fx:id="graficoEstadoProyectos" VBox.vgrow="ALWAYS"/>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Proyectos Activos - Último Seguimiento"
                                   style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                            <TableView fx:id="tablaProyectosActivos" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colProyecto" text="Proyecto" prefWidth="200"/>
                                    <TableColumn fx:id="colAvance" text="\% Avance" prefWidth="90"/>
                                    <TableColumn fx:id="colUltimoSeguimiento" text="Último Seguimiento" prefWidth="140"/>
                                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="150"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </HBox>

                    <!-- FILA 3: Barras -->
                    <VBox spacing="8" VBox.vgrow="ALWAYS">
                        <Label text="Progreso de Proyectos Activos"
                               style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                        <BarChart fx:id="graficoAvanceProyectos" VBox.vgrow="ALWAYS">
                            <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                            <yAxis><NumberAxis side="LEFT" lowerBound="0" upperBound="100" tickUnit="10"/></yAxis>
                        </BarChart>
                    </VBox>

                </VBox>
            </children>
        </AnchorPane>
    </center>

</BorderPane>